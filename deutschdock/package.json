{
  "name": "deutsch-lernen",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {"node":"^22.22.2 || ^24.15.0 || >=26.0.0"},
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "tsc -b && vite build",
    "start": "node server/index.js",
    "test": "node --experimental-strip-types --test server/*.test.js server/a2/*.test.js src/*.test.ts",
    "validate:content": "node server/a2/validate.js",
    "validate:exams": "node server/a2/exam-validation.js",
    "validate:bank": "node scripts/validate-bank.js",
    "test:ui": "tsx --test src/a2/*.test.tsx"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "jsdom": "^31.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.7.3",
    "vite": "^6.0.5"
  }
}
