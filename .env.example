# Optional server configuration. Never prefix keys with VITE_.
# Copy to .env and restart the server.
# Optional text provider for writing feedback and AI dialogue: gemini or openai.
# Gemini free-tier text prompts may be used by Google to improve products; see README privacy note.
A2_AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash-lite
# OpenAI is still used for optional transcription and speech, or as text provider if selected above.
OPENAI_API_KEY=
# Set a text model available to your account for feedback and dialogue.
OPENAI_TEXT_MODEL=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Optional German partner speech. Leave empty to use browser voices.
OPENAI_SPEECH_MODEL=
# PORT=3001
# DATA_DIR=C:/path/to/private-data
